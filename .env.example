# PostgreSQL connection (default: local docker compose service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amazon_seller_os"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# LLM（OpenAI 兼容接口）
LLM_API_KEY="your-api-key"
LLM_BASE_URL="https://llmapi.3chai.com"
LLM_MODEL="glm-5.3"
